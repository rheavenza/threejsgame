{
  "name": "assetforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "check": "for file in src/*.mjs src/providers/*.mjs scripts/*.mjs test/*.mjs; do node --check \"$file\" || exit; done",
    "test": "node --test test/*.test.mjs",
    "validate-sample": "node src/cli.mjs validate samples/market-stall.json",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "zod": "4.6.7"
  }
}
