{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://threejsgame.local/schemas/asset-spec.v1.schema.json",
  "title": "ThreeJSGAME asset specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "category", "style_tokens", "tri_budget", "palette"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "category": {
      "enum": ["prop", "building", "foliage", "character", "creature"]
    },
    "style_tokens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 48 }
    },
    "tri_budget": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "palette": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 24,
      "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
    },
    "skeleton": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 },
    "clip_list": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "ticket": { "type": "string", "pattern": "^T[0-9]{2}-[0-9]{3}$" },
    "notes": { "type": "string", "maxLength": 2000 }
  },
  "allOf": [
    {
      "if": { "properties": { "category": { "enum": ["character", "creature"] } } },
      "then": {
        "properties": { "skeleton": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 } },
        "required": ["skeleton"]
      }
    }
  ]
}
