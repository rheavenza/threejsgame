{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://threejsgame.local/schemas/manifest.v1.schema.json",
  "title": "ThreeJSGAME asset provenance manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "version", "category", "ticket", "stages", "spec_hash",
    "prompt_hash", "input_concept_id", "license_status", "outputs", "manual_edits",
    "qa_status", "publication_status", "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
    "category": { "enum": ["prop", "building", "foliage", "character", "creature"] },
    "ticket": { "type": ["string", "null"], "pattern": "^T[0-9]{2}-[0-9]{3}$" },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "provider", "model", "parameters", "seed", "started_at", "finished_at"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "blocked", "failed", "not_run"] },
          "provider": { "type": ["string", "null"] },
          "model": { "type": ["string", "null"] },
          "parameters": { "type": "object" },
          "seed": { "type": ["integer", "null"] },
          "started_at": { "type": "string", "format": "date-time" },
          "finished_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "spec_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "prompt_hash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "input_concept_id": { "type": ["string", "null"] },
    "license_status": { "enum": ["prototype", "cleared"] },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "manual_edits": { "type": "array", "items": { "type": "string" } },
    "qa_status": { "enum": ["not_run", "passed", "failed"] },
    "publication_status": { "enum": ["not_published", "published"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
